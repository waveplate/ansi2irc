# === Utility: color math ===
def unpack_rgb(rgb: int) -> Tuple[int, int, int]:
    return ((rgb >> 16) & 0xFF, (rgb >> 8) & 0xFF, (rgb >> 0) & 0xFF)


def is_near_grayscale(col: int, tolerance: int) -> bool:
    r, g, b = unpack_rgb(col)
    return max(r, g, b) - min(r, g, b) <= tolerance

def sq_distance(a: int, b: int) -> int:
    ar, ag, ab = unpack_rgb(a)
    br, bg, bb = unpack_rgb(b)
    dr = ar - br
    dg = ag - bg
    db = ab - bb
    return dr * dr + dg * dg + db * db

def nearest_in_palette(col: int, palette: List[int], mask: Optional[List[bool]] = None) -> int:
    best_i = 0
    best_d = 1 << 62
    for i, p in enumerate(palette):
        if mask is not None and not mask[i]:
            continue
        d = sq_distance(col, p)
        if d < best_d:
            best_d = d
            best_i = i
            if d == 0:
                break
    return best_i

def nearest_distinct(col: int, palette: List[int], tolerance: int) -> Optional[int]:
    best_i: Optional[int] = None
    best_d = 1 << 62
    for i, p in enumerate(palette):
        if is_near_grayscale(p, tolerance):
            continue
        d = sq_distance(col, p)
        if d < best_d:
            best_d = d
            best_i = i
            if d == 0:
                break
    return best_i


# === Lookup table generation & cache ===
CACHE_DIR = os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache"))
CACHE_PATH = os.path.join(CACHE_DIR, "ansi2irc", "lookup.json")
CACHE_VERSION = 2  # Incremented due to palette fix


def build_lookup_tables(tolerance: int) -> Dict[str, List[int]]:
    # Masks for grayscale vs chromatic buckets for each palette
    irc_is_gray = [is_near_grayscale(c, tolerance) for c in IRC99]
    ansi_is_gray = [is_near_grayscale(c, tolerance) for c in ANSI256]

    # IRC→ANSI: for each IRC colour, map to nearest ANSI bucket-wise
    irc_to_ansi: List[int] = [0] * len(IRC99)
    for i, col in enumerate(IRC99):
        if irc_is_gray[i]:
            # restrict to grayscale ANSI
            mask = ansi_is_gray
            irc_to_ansi[i] = nearest_in_palette(col, ANSI256, mask)
        else:
            # prefer distinctly chromatic ANSI; fallback to general nearest
            j = nearest_distinct(col, ANSI256, tolerance)
            irc_to_ansi[i] = j if j is not None else nearest_in_palette(col, ANSI256)

    # ANSI→IRC: for each ANSI colour, map to nearest IRC bucket-wise
    ansi_to_irc: List[int] = [0] * len(ANSI256)
    for i, col in enumerate(ANSI256):
        if ansi_is_gray[i]:
            mask = irc_is_gray
            ansi_to_irc[i] = nearest_in_palette(col, IRC99, mask)
        else:
            j = nearest_distinct(col, IRC99, tolerance)
            ansi_to_irc[i] = j if j is not None else nearest_in_palette(col, IRC99)

    return {
        "tolerance": tolerance,
        "version": CACHE_VERSION,
        "irc_to_ansi": irc_to_ansi,
        "ansi_to_irc": ansi_to_irc,
    }

def ensure_cache_dirs(path: str) -> None:
    d = os.path.dirname(path)
    os.makedirs(d, exist_ok=True)

def load_or_build_tables(tolerance: int, use_cache: bool, rebuild: bool) -> Dict[str, List[int]]:
    if use_cache and not rebuild and os.path.exists(CACHE_PATH):
        try:
            with open(CACHE_PATH, "r", encoding="utf-8") as f:
                data = json.load(f)
            if (
                isinstance(data, dict)
                and data.get("version") == CACHE_VERSION
                and data.get("tolerance") == tolerance
                and isinstance(data.get("irc_to_ansi"), list)
                and isinstance(data.get("ansi_to_irc"), list)
                and len(data["irc_to_ansi"]) == len(IRC99)
                and len(data["ansi_to_irc"]) == len(ANSI256)
            ):
                return data
        except Exception:
            pass  # fall through to rebuild

    data = build_lookup_tables(tolerance)
    if use_cache:
        try:
            ensure_cache_dirs(CACHE_PATH)
            tmp = CACHE_PATH + ".tmp"
            with open(tmp, "w", encoding="utf-8") as f:
                json.dump(data, f)
            os.replace(tmp, CACHE_PATH)
        except Exception:
            pass
    return data


# === Conversion: IRC <-> ANSI ===
# IRC control bytes
IRC_COLOR = "\x03"
IRC_BOLD = "\x02"
IRC_UNDER = "\x1f"
IRC_REVERSE = "\x16"
IRC_ITALIC = "\x1d"
IRC_RESET = "\x0f"

# ANSI sequences helpers
ESC = "\x1b"
# Match all CSI sequences 
ANSI_RE = re.compile(r"\x1b\[([0-9;:<=>?]*)([a-zA-Z@])")


class AttrState:
    def __init__(self) -> None:
        self.reset()

    def reset(self) -> None:
        self.fg: Optional[int] = None  # code index in target palette
        self.bg: Optional[int] = None
        self.bold = False
        self.under = False
        self.reverse = False
        self.italic = False

    def copy(self) -> 'AttrState':
        n = AttrState()
        n.fg = self.fg
        n.bg = self.bg
        n.bold = self.bold
        n.under = self.under
        n.reverse = self.reverse
        n.italic = self.italic
        return n

    def __eq__(self, other: object) -> bool:
        if not isinstance(other, AttrState):
            return NotImplemented
        return (self.fg == other.fg and self.bg == other.bg and 
                self.bold == other.bold and self.under == other.under and 
                self.reverse == other.reverse and self.italic == other.italic)


class Cell(NamedTuple):
    char: str
    attr: AttrState

class VirtualTerminal:
    def __init__(self, width: int = 80):
        self.width = width
        self.grid: Dict[Tuple[int, int], Cell] = {}
        self.cursor_x = 0
        self.cursor_y = 0
        self.saved_cursor = (0, 0)
        self.current_attr = AttrState()
        self.max_y = 0

    def write(self, text: str) -> None:
        for ch in text:
            if ch == '\n':
                self.cursor_y += 1
                self.cursor_x = 0
                self.max_y = max(self.max_y, self.cursor_y)
            elif ch == '\r':
                self.cursor_x = 0
            elif ch == '\b':
                self.cursor_x = max(0, self.cursor_x - 1)
            elif ch == '\t':
                # Tab stop every 8
                self.cursor_x = (self.cursor_x // 8 + 1) * 8
            elif ord(ch) >= 32:
                # Wrap?
                if self.width and self.cursor_x >= self.width:
                    self.cursor_x = 0
                    self.cursor_y += 1

                self.grid[(self.cursor_x, self.cursor_y)] = Cell(ch, self.current_attr.copy())
                self.cursor_x += 1
                self.max_y = max(self.max_y, self.cursor_y)

    def move_cursor(self, x: Optional[int] = None, y: Optional[int] = None, relative: bool = False) -> None:
        if relative:
            if x is not None: self.cursor_x += x
            if y is not None: self.cursor_y += y
        else:
            if x is not None: self.cursor_x = x
            if y is not None: self.cursor_y = y

        # Clamp?
        self.cursor_x = max(0, self.cursor_x)
        self.cursor_y = max(0, self.cursor_y)
        self.max_y = max(self.max_y, self.cursor_y)

    def erase_in_display(self, mode: int) -> None:
        # 2: clear all
        if mode == 2:
            self.grid.clear()
            self.cursor_x = 0
            self.cursor_y = 0
            self.max_y = 0
        elif mode == 0:
            # Clear from cursor to end (simplified: just remove future keys?)
            keys_to_remove = [k for k in self.grid if (k[1] > self.cursor_y) or (k[1] == self.cursor_y and k[0] >= self.cursor_x)]
            for k in keys_to_remove:
                del self.grid[k]
        elif mode == 1:
            # Clear from start to cursor
            keys_to_remove = [k for k in self.grid if (k[1] < self.cursor_y) or (k[1] == self.cursor_y and k[0] <= self.cursor_x)]
            for k in keys_to_remove:
                del self.grid[k]

    def erase_in_line(self, mode: int) -> None:
        # 0: cursor to end
        # 1: start to cursor
        # 2: whole line
        y = self.cursor_y
        if mode == 0:
            keys_to_remove = [k for k in self.grid if k[1] == y and k[0] >= self.cursor_x]
        elif mode == 1:
            keys_to_remove = [k for k in self.grid if k[1] == y and k[0] <= self.cursor_x]
        elif mode == 2:
            keys_to_remove = [k for k in self.grid if k[1] == y]
        else:
            return

        for k in keys_to_remove:
            del self.grid[k]

    def save_cursor_pos(self) -> None:
        self.saved_cursor = (self.cursor_x, self.cursor_y)

    def restore_cursor_pos(self) -> None:
        self.cursor_x, self.cursor_y = self.saved_cursor

    def render(self) -> str:
        # Convert grid to IRC string
        lines = []
        # Find bounds
        if not self.grid:
            return ""

        real_max_y = max(k[1] for k in self.grid.keys())

        for y in range(real_max_y + 1):
            line_parts = []

            line_cells = {k[0]: v for k, v in self.grid.items() if k[1] == y}
            if not line_cells:
                lines.append("")
                continue

            max_line_x = max(line_cells.keys())

            last_attr = AttrState() # Reset at start of line

            current_x = 0
            while current_x <= max_line_x:
                cell = line_cells.get(current_x)
                if cell:
                    new_attr = cell.attr
                    changes = []

                    color_changed = (new_attr.fg != last_attr.fg) or (new_attr.bg != last_attr.bg)

                    if new_attr.bold != last_attr.bold:
                        changes.append(IRC_BOLD)
                        last_attr.bold = new_attr.bold
                    if new_attr.italic != last_attr.italic:
                        changes.append(IRC_ITALIC)
                        last_attr.italic = new_attr.italic
                    if new_attr.under != last_attr.under:
                        changes.append(IRC_UNDER)
                        last_attr.under = new_attr.under
                    if new_attr.reverse != last_attr.reverse:
                        changes.append(IRC_REVERSE)
                        last_attr.reverse = new_attr.reverse

                    if color_changed:
                        def is_valid(val):
                            return str(val).isnumeric()

                        fg_val = new_attr.fg
                        bg_val = new_attr.bg

                        if is_valid(fg_val) and is_valid(bg_val):
                            changes.append(f"{IRC_COLOR}{fg_val},{bg_val}")
                        elif is_valid(fg_val):
                            changes.append(f"{IRC_COLOR}{fg_val}")
                        elif is_valid(bg_val) and is_valid(last_attr.fg):
                            changes.append(f"{IRC_COLOR}{last_attr.fg},{bg_val}")
                        elif is_valid(bg_val):
                            changes.append(f"{IRC_COLOR}{bg_val},{bg_val}")
                        else:
                            changes.append(IRC_COLOR)

                        last_attr.fg = new_attr.fg
                        last_attr.bg = new_attr.bg

                    line_parts.append("".join(changes))
                    line_parts.append(cell.char)
                else:
                    default_attr = AttrState()
                    if last_attr != default_attr:
                         changes = []
                         changes.append(IRC_RESET)
                         last_attr = default_attr
                         line_parts.append("".join(changes))

                    line_parts.append(" ")

                current_x += 1

            line_parts.append(IRC_RESET)
            lines.append("".join(line_parts))

        return "\n".join(lines)


def make_sgr(state: AttrState, fg_code: Optional[int], bg_code: Optional[int], truecolor: bool = False) -> str:
    parts: List[str] = ["0"]  # start from reset for simplicity and correctness
    if fg_code is not None:
        if truecolor:
            r, g, b = unpack_rgb(fg_code)
            parts += ["38", "2", str(r), str(g), str(b)]
        else:
            parts += ["38", "5", str(fg_code)]
    if bg_code is not None:
        if truecolor:
            r, g, b = unpack_rgb(bg_code)
            parts += ["48", "2", str(r), str(g), str(b)]
        else:
            parts += ["48", "5", str(bg_code)]
    if state.bold:
        parts.append("1")
    if state.italic:
        parts.append("3")
    if state.under:
        parts.append("4")
    if state.reverse:
        parts.append("7")

    def fold(parts: List[str]) -> List[str]:
        out: List[str] = []
        i = 0
        while i < len(parts):
            if parts[i] in ("38", "48") and i + 2 < len(parts) and parts[i + 1] in ("2", "5"):
                if parts[i+1] == "5":
                    out.append(parts[i] + ";" + parts[i + 1] + ";" + parts[i + 2])
                    i += 3
                elif parts[i+1] == "2" and i + 4 < len(parts):
                    out.append(parts[i] + ";" + parts[i + 1] + ";" + parts[i + 2] + ";" + parts[i + 3] + ";" + parts[i + 4])
                    i += 5
                else:
                    out.append(parts[i])
                    i += 1
            else:
                out.append(parts[i])
                i += 1
        return out

    folded = fold(parts)
    return ESC + "[" + ";".join(folded) + "m"


def irc_to_ansi(text: str, tables: Dict[str, List[int]], truecolor: bool = False) -> str:
    irc_to_ansi_map = tables["irc_to_ansi"]
    out: List[str] = []
    state = AttrState()

    i = 0
    n = len(text)
    while i < n:
        ch = text[i]
        if ch == IRC_COLOR:
            i += 1
            start = i
            fg: Optional[int] = None
            bg: Optional[int] = None
            j = i
            while j < n and text[j].isdigit() and (j - i) < 2:
                j += 1
            if j > i:
                try:
                    fg = int(text[i:j])
                except ValueError:
                    fg = None
                i = j
                if i < n and text[i] == ",":
                    i += 1
                    k = i
                    while k < n and text[k].isdigit() and (k - i) < 2:
                        k += 1
                    if k > i:
                        try:
                            bg = int(text[i:k])
                        except ValueError:
                            bg = None
                        i = k
            else:
                state.fg = None
                state.bg = None
                out.append(make_sgr(state, None, None, truecolor))
                continue

            if fg is not None:
                if truecolor:
                    state.fg = IRC99[fg] if 0 <= fg < len(IRC99) else None
                else:
                    state.fg = irc_to_ansi_map[fg] if 0 <= fg < len(irc_to_ansi_map) else None
            if bg is not None:
                if truecolor:
                    state.bg = IRC99[bg] if 0 <= bg < len(IRC99) else None
                else:
                    state.bg = irc_to_ansi_map[bg] if 0 <= bg < len(irc_to_ansi_map) else None

            out.append(make_sgr(state, state.fg, state.bg, truecolor))
        elif ch == IRC_BOLD:
            state.bold = not state.bold
            out.append(make_sgr(state, state.fg, state.bg, truecolor))
            i += 1
        elif ch == IRC_UNDER:
            state.under = not state.under
            out.append(make_sgr(state, state.fg, state.bg, truecolor))
            i += 1
        elif ch == IRC_REVERSE:
            state.reverse = not state.reverse
            out.append(make_sgr(state, state.fg, state.bg, truecolor))
            i += 1
        elif ch == IRC_ITALIC:
            state.italic = not state.italic
            out.append(make_sgr(state, state.fg, state.bg, truecolor))
            i += 1
        elif ch == IRC_RESET:
            state.reset()
            out.append(ESC + "[0m")
            i += 1
        else:
            out.append(ch)
            i += 1
    out.append(ESC + "[0m")
    return "".join(out)

def rgb_to_irc_code(rgb: int, tolerance: int) -> int:
    gray = is_near_grayscale(rgb, tolerance)
    irc_is_gray = [is_near_grayscale(c, tolerance) for c in IRC99]
    if gray:
        return nearest_in_palette(rgb, IRC99, mask=irc_is_gray)
    j = nearest_distinct(rgb, IRC99, tolerance)
    return j if j is not None else nearest_in_palette(rgb, IRC99)

def ansi_to_irc(text: str, tables: Dict[str, List[int]], tolerance: int, wrap_width: Optional[int] = None) -> str:
    ansi_to_irc_map = tables["ansi_to_irc"]

    # Initialize Virtual Terminal
    # width is wrap_width (can be None)
    vt = VirtualTerminal(width=wrap_width)

    pos = 0
    for m in ANSI_RE.finditer(text):
        if m.start() > pos:
            vt.write(text[pos:m.start()])

        params_str = m.group(1)
        cmd = m.group(2)

        params = []
        if params_str:
            for p in params_str.split(';'):
                 if p.isdigit():
                     params.append(int(p))
                 else:
                     params.append(0)

        def get_param(idx: int, default: int = 1) -> int:
            if idx < len(params) and params[idx] != 0:
                return params[idx]
            return default

        if cmd == 'A': 
            n = get_param(0, 1)
            vt.move_cursor(y=-n, relative=True)
        elif cmd == 'B': 
            n = get_param(0, 1)
            vt.move_cursor(y=n, relative=True)
        elif cmd == 'C': 
            n = get_param(0, 1)
            vt.move_cursor(x=n, relative=True)
        elif cmd == 'D': 
            n = get_param(0, 1)
            vt.move_cursor(x=-n, relative=True)
        elif cmd == 'H' or cmd == 'f': 
            row = get_param(0, 1) - 1
            col = get_param(1, 1) - 1
            vt.move_cursor(x=col, y=row)
        elif cmd == 'J': 
            mode = get_param(0, 0)
            vt.erase_in_display(mode)
        elif cmd == 'K': 
            mode = get_param(0, 0)
            vt.erase_in_line(mode)
        elif cmd == 's': 
            vt.save_cursor_pos()
        elif cmd == 'u': 
            vt.restore_cursor_pos()
        elif cmd == 'm': 
            i = 0
            if not params:
                params = [0]

            while i < len(params):
                p = params[i]
                if p == 0:
                    vt.current_attr.reset()
                elif p == 1:
                    vt.current_attr.bold = True
                elif p == 22:
                    vt.current_attr.bold = False
                elif p == 3:
                    vt.current_attr.italic = True
                elif p == 23:
                    vt.current_attr.italic = False
                elif p == 4:
                    vt.current_attr.under = True
                elif p == 24:
                    vt.current_attr.under = False
                elif p == 7:
                    vt.current_attr.reverse = True
                elif p == 27:
                    vt.current_attr.reverse = False
                elif p == 39:
                    vt.current_attr.fg = None
                elif p == 49:
                    vt.current_attr.bg = None
                elif 30 <= p <= 37:
                    idx = p - 30
                    vt.current_attr.fg = ansi_to_irc_map[idx]
                elif 90 <= p <= 97:
                    idx = p - 90 + 8
                    vt.current_attr.fg = ansi_to_irc_map[idx]
                elif 40 <= p <= 47:
                    idx = p - 40
                    vt.current_attr.bg = ansi_to_irc_map[idx]
                elif 100 <= p <= 107:
                    idx = p - 100 + 8
                    vt.current_attr.bg = ansi_to_irc_map[idx]
                elif p == 38: 
                    if i + 2 < len(params) and params[i+1] == 5:
                        idx = params[i+2]
                        vt.current_attr.fg = ansi_to_irc_map[idx] if idx < len(ansi_to_irc_map) else 0
                        i += 2
                    elif i + 4 < len(params) and params[i+1] == 2:
                        r, g, b = params[i+2], params[i+3], params[i+4]
                        rgb = (r << 16) | (g << 8) | b
                        vt.current_attr.fg = rgb_to_irc_code(rgb, tolerance)
                        i += 4
                    else:
                        pass 
                elif p == 48: 
                    if i + 2 < len(params) and params[i+1] == 5:
                        idx = params[i+2]
                        vt.current_attr.bg = ansi_to_irc_map[idx] if idx < len(ansi_to_irc_map) else 0
                        i += 2
                    elif i + 4 < len(params) and params[i+1] == 2:
                        r, g, b = params[i+2], params[i+3], params[i+4]
                        rgb = (r << 16) | (g << 8) | b
                        vt.current_attr.bg = rgb_to_irc_code(rgb, tolerance)
                        i += 4
                    else:
                        pass

                i += 1

        pos = m.end()

    if pos < len(text):
        vt.write(text[pos:])

    return vt.render()

def detect_direction(sample: str) -> str:
    if ANSI_RE.search(sample):
        return "irc"
    if any(c in sample for c in (IRC_COLOR, IRC_BOLD, IRC_UNDER, IRC_REVERSE, IRC_ITALIC, IRC_RESET)):
        return "ansi"
    return "irc"

def main() -> None:
    ap = argparse.ArgumentParser(description="Convert between ANSI SGR and IRC color/control codes")
    ap.add_argument("-d", "--direction", choices=["irc", "ansi", "auto"], default="auto",
                    help="Conversion direction (default: auto-detect)")
    ap.add_argument("-t", "--tolerance", type=int, default=16,
                    help="Grayscale tolerance for chroma separation (default: 16)")
    ap.add_argument("-e", "--encoding", help="Input encoding")
    ap.add_argument("--cp437", action="store_true", help="Force CP437 encoding (suitable for ANSI art)")
    ap.add_argument("-w", "--width", type=int, default=None, help="Wrap width for ansi2irc (default: 80 if cp437)")
    ap.add_argument("--truecolor", action="store_true", help="Use 24-bit Truecolor ANSI output instead of 256-color palette")
    ap.add_argument("-c", "--no-cache", action="store_true", help="Do not read/write cache")
    ap.add_argument("-r", "--rebuild", action="store_true", help="Force rebuild lookup tables")
    ap.add_argument("file", nargs="?", help="Input file (default: stdin)")
    args = ap.parse_args()

    use_cache = not args.no_cache
    tables = load_or_build_tables(args.tolerance, use_cache=use_cache, rebuild=args.rebuild)

    if args.file:
        try:
            input_stream = open(args.file, "rb")
        except Exception as e:
            sys.stderr.write(f"Error opening file {args.file}: {e}\n")
            sys.exit(1)
    else:
        input_stream = sys.stdin.buffer

    with input_stream:
        raw_data = input_stream.read()

    data: Optional[str] = None

    encoding = args.encoding
    if args.cp437:
        encoding = "cp437"

    if encoding:
        try:
            data = raw_data.decode(encoding)
        except Exception as e:
            sys.stderr.write(f"Error decoding input with {encoding}: {e}\n")
            sys.exit(1)
    else:
        try:
            data = raw_data.decode("utf-8")
        except UnicodeDecodeError:
            data = raw_data.decode("latin1", errors="replace")

    direction = args.direction
    if direction == "auto":
        direction = detect_direction(data)

    if direction == "ansi":
        sys.stdout.write(irc_to_ansi(data, tables, truecolor=args.truecolor))
    else:
        wrap_width = args.width
        if wrap_width is None and args.cp437:
            wrap_width = 80
        sys.stdout.write(ansi_to_irc(data, tables, args.tolerance, wrap_width=wrap_width))


if __name__ == "__main__":
    main()
